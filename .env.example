# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=https://trustpages.fly.dev
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_live_...
# MUST be an address on a domain verified in Resend. onboarding@resend.dev is a
# shared sandbox sender that only ever delivers to the account owner's own
# address — subscriber notifications to anyone else are silently dropped.
RESEND_FROM_EMAIL=TrustPages <noreply@usetrustpages.com>

# ── Billing (Paddle) ───────────────────────────────────────────────────────────
# Server-side API key (Paddle > Developer tools > Authentication) — keep secret.
PADDLE_API_KEY=pdl_...
# Client-side token (Paddle > Developer tools > Authentication) — safe to expose
# in frontend code, used by Paddle.js on the checkout page.
PADDLE_CLIENT_TOKEN=live_...
# Webhook signing secret (Paddle > Developer tools > Notifications > your endpoint).
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_ID_GROWTH=pri_...
PADDLE_PRICE_ID_GROWTH_YEARLY=pri_...
# Starter is the middle tier. Leave blank until a real price exists in
# Paddle for it — checkout returns 503 for a blank price id, same as it
# already does for Growth, rather than starting a checkout with no price.
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_STARTER_YEARLY=
# "sandbox" while testing, "production" once live.
PADDLE_ENVIRONMENT=sandbox

# ── Monitoring reliability (optional — defaults shown) ───────────────────────
# Consecutive failed checks before a source gets the "Monitoring Alert" badge
# and email.
# MONITORING_ALERT_FAILURE_THRESHOLD=3
# Days to wait before re-sending that email for the same ongoing outage.
# MONITORING_ALERT_DEDUPE_DAYS=7
# Per-tenant, per-UTC-day cap on Tier-2 (Playwright) runs — see the sweep-cost
# note in CLAUDE.md before raising these.
# TIER2_DAILY_LIMIT_FREE=3
# TIER2_DAILY_LIMIT_STARTER=10
# TIER2_DAILY_LIMIT_GROWTH=30

# ── Observability (optional) ──────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ── Analytics (optional) ───────────────────────────────────────────────────────
# GA4 measurement ID from analytics.google.com → Admin → Data Streams
# GA_MEASUREMENT_ID=G-XXXXXXX
